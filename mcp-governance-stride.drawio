;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;P2&lt;/b&gt; Managed client on Windows device&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Spoofing&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;A user-started local stdio server uses a command name that looks like an approved one.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-stdio&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;4.2&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;I11&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;F1&lt;/b&gt; Policy sync: Git to pipeline to policy targets&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Information disclosure&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Target credentials or the list leak in transit or in the run log.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-pipeline&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;4.0&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/