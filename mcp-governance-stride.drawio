:#FFFFFF;&#x27;&gt;ctrl-g-write-approval ctrl-purview-audit&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;2&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;3.4&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#E7F6EC;&#x27;&gt;Low&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#E7F6EC;color:#1E7F3E;border:1px solid #1E7F3E;&#x27;&gt;T12&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;F2&lt;/b&gt; Tool call: client or agent to gateway&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Tampering&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&g