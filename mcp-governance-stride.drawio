ottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-backend&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;4.4&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;R6&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;P2&lt;/b&gt; Managed client on Windows device&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Repudiation&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;A local MCP process on a device where Defender for Endpoint runtime protection is not active leaves no record, so a bypass cannot be traced to a person.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-logging ctrl-g-defender-for-endpoint-runtime-protection&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;4.2&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;R9&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;P5&lt;/b&gt; Company MCP 