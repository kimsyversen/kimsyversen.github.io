#x27;22&#x27;/&gt;&lt;col width=&#x27;22&#x27;/&gt;&lt;col width=&#x27;22&#x27;/&gt;&lt;col width=&#x27;22&#x27;/&gt;&lt;col width=&#x27;24&#x27;/&gt;&lt;col width=&#x27;40&#x27;/&gt;&lt;col width=&#x27;58&#x27;/&gt;&lt;col width=&#x27;360&#x27;/&gt;&lt;tr&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;ID&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Element&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;STRIDE&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Threat (interpretation by AI)&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Page control ids&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;D&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;R&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;E&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;A&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Di&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Score&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Rating&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Evidence&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weigh