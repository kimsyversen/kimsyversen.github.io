eight="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;table style=&#x27;border-collapse:collapse;font-size:11px;width:1250px&#x27; cellpadding=&#x27;0&#x27;&gt;&lt;col width=&#x27;640&#x27;/&gt;&lt;col width=&#x27;560&#x27;/&gt;&lt;col width=&#x27;50&#x27;/&gt;&lt;tr&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;SC-500 skill measured (Microsoft Learn study guide, page last updated 2026-05-13)&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Threat ids it helps with&lt;/th&gt;&lt;th align=&#x27;left&#x27; style=&#x27;padding:6px;background:#1F2937;color:#ffffff;&#x27;&gt;Count&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;1.1 Implement conditional access policies&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;S1, S2, S3, S8, I12&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;1.1 Implement and configure Privileged Identity Management (PIM)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;S3, T5, E2&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;1.1 Implement and configure managed identities for Azure resources&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;S5, S9, I4, E1, E5, E6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;1.1 Implement and configure identity for applications, including enterprise applications and app registrations&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;S9, I14&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;1.1 Manage OAuth permission grants and consent settings&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;S10, T5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;1.2 Configure access to Key Vault&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;S5, I1, I4, I11&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;1.2 Scan for secrets by using Defender Cloud Security Posture Management (Defender CSPM)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;I1, I8, I11, I12&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;1.3 Implement and configure security controls by using infrastructure as code&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;T1, T8, T11, R5, R11&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;1.3 Evaluate and remediate overprivileged access assignments by using Azure role-based access control (RBAC)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;T10, I6, I10, E1, E2, E5, E6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;1.3 Implement and configure security controls by using Azure Policy&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;T5, T8, T9, D7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;2.3 Configure Azure private endpoints to secure access to Azure platform as a service (PaaS) resources&lt;/td&gt;&lt;td valign=&#