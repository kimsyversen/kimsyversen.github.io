nline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;S2&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;EE2&lt;/b&gt; Microsoft 365 Copilot user&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Spoofing&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;The gateway trusts Microsoft 365 Copilot&amp;#x27;s fixed outbound addresses without checking the caller, so a caller from another Copilot tenant on those addresses gets in.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-m365-network ctrl-identity&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;5.0&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;S4&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;EE4&lt;/b&gt; Unapproved or malicious MCP server&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Spoofing&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;A server with a look-alike address matches an allowlist wildcard and is treated as approved.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-client ctrl-inventory&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;5.0&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;T5&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;P4&lt;/b&gt; Gateway (API Management or AI Gateway)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Tampering&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Someone changes a gateway policy, or the Agent 365 consent lets a service write API-scoped policies.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-a365-consent ctrl-a365&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;8&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;5.0&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;D11&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;F2&lt;/b&gt; Tool call: client or agent to gateway&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Denial of service&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Microsoft changes the fixed outbound address list with seven days&amp;#x27; notice, and calls from Microsoft 365 Copilot start to fail.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-m365-network&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;4.8&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#B7791F;color:#ffffff;border:1px solid #B7791F;&#x27;&gt;I14&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;F4&lt;/b&gt; Tool response back to the agent&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Information disclosure&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;A response with data for one user is returned to another user&amp;#x27;s agent session.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-identity ctrl-ttp-users&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;4.8&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;&lt;b&gt;disclosed&lt;/b&gt;&lt;br&gt;Asana MCP server bug could have shown one customer&amp;#x27;s data to other MCP users (found 2025-06-04, vendor says no confirmed access)&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;https://theregister.com/2025/06/18/asana_mcp_server_bug/&lt;/font&gt;&lt;br&gt;CVE-2026-48529 GitHub MCP Server in HTTP lockdown mode runs later users&amp;#x27; queries with the first user&amp;#x27;s credentials&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;https://nvd.nist.gov/vuln/detail/CVE-2026-48529&lt;/font&gt;&lt;br&gt;CVE-2026-52869 MCP Python SDK serves a session to any caller that knows the session ID, whatever token it carries&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;https://nvd.nist.gov/vuln/detail/CVE-2026-52869&lt;/font&gt;&lt;br&gt;CVE-2026-25536 MCP TypeScript SDK leaks response data across clients when one server and transport instance is reused&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;https://nvd.nist.gov/vuln/detail/CVE-2026-25536&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;I4&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;P4&lt;/b&gt; Gateway (API Management or AI Gateway)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Information disclosure&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Gateway logs store tool arguments with personal data, or a shared backend connection exposes its permissions to every caller.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-ai-publish ctrl-logging&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;4.8&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;R10&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;P6&lt;/b&gt; Defender and threat detection checks (preview)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Repudiation&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;The default Defender rule only audits, and nobody reads the audit.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-g-defender-rules-and-scope ctrl-logging&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;2&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;4.8&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;R12&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;DS2&lt;/b&gt; Policy targets (GitHub, Foundry, Power Platform, M365 admin center)&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Repudiation&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;Target changes made by hand carry no link to a reviewed request.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;ctrl-m365 ctrl-logging&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;7&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;3&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;4&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F9FAFB;&#x27;&gt;&lt;b&gt;4.8&lt;/b&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFF6E0;&#x27;&gt;Medium&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#F2F4F7;&#x27;&gt;theoretical (interpretation by AI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;span style=&#x27;display:inline-block;margin:1px;padding:0 4px;border-radius:3px;font-size:10px;font-weight:bold;line-height:15px;background:#FFF6E0;color:#B7791F;border:1px solid #B7791F;&#x27;&gt;R13&lt;/span&gt;&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;&lt;b&gt;DS3&lt;/b&gt; Logs and Purview audit&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Repudiation&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;Client side telemetry is missing for unmanaged devices and cloud agents outside the device rules.&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;ctrl-logging&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;5&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x27;&gt;6&lt;/td&gt;&lt;td valign=&#x27;top&#x27; style=&#x27;padding:4px 6px;border-bottom:1px solid #E4E7EC; background:#FFFFFF;&#x