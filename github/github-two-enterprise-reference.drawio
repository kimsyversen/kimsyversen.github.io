<mxCell id="policy-24" value="&lt;b&gt;Enterprise sets the floor&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f1b2d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="policy-22"><mxGeometry x="64" y="14" width="284.4" height="20" as="geometry"/></mxCell><mxCell id="policy-25" value="Baselines target all repos in scope." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#55657a;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="policy-22"><mxGeometry x="64" y="36" width="284.4" height="34" as="geometry"/></mxCell><mxCell id="policy-26" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="policy-22"><mxGeometry x="360.4" y="18" width="40" height="40" as="geometry"/></mxCell><mxCell id="policy-27" value="&lt;b&gt;Rulesets combine&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f1b2d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="policy-22"><mxGeometry x="410.4" y="14" width="284.4" height="20" as="geometry"/></mxCell><mxCell id="policy-28" value="When rulesets overlap, the most restrictive version of a rule applies." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#55657a;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="policy-22"><mxGeometry x="410.4" y="36" width="284.4" height="34" as="geometry"/></mxCell><mxCell id="policy-29" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+